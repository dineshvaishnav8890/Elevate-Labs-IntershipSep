
pipeline {
    agent any

    environment {
        IMAGE_NAME = 'nodejs-jenkins-cicd'
        CONTAINER_NAME = 'nodejs-jenkins-cicd'
        APP_PORT = '3000'
    }

    stages {
        stage('Install Dependencies') {
            steps {
                dir('Jenkins-Second-Project') {
                    sh 'npm install'
                }
            }
        }

        stage('Test') {
            steps {
                dir('Jenkins-Second-Project') {
                    sh 'npm test'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('Jenkins-Second-Project') {
                    sh 'docker build -t $IMAGE_NAME:$BUILD_NUMBER .'
                }
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    docker rm -f $CONTAINER_NAME || true
                    docker run -d --restart unless-stopped \
                      --name $CONTAINER_NAME \
                      -p $APP_PORT:3000 \
                      $IMAGE_NAME:$BUILD_NUMBER
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the stage logs.'
        }
    }
}
